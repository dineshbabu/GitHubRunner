// Structured logger (paste if not already present)
function L(tag, msg, meta) {
  try {
    const ss = SpreadsheetApp.getActive();
    const tz = ss ? ss.getSpreadsheetTimeZone() : 'GMT';
    const time = Utilities.formatDate(new Date(), tz, 'HH:mm:ss');
    const metaText = (meta === undefined) ? '' : ' | ' + JSON.stringify(meta);
    Logger.log('%s %s: %s%s', time, String(tag).toUpperCase(), String(msg), metaText);
  } catch (e) {
    try { Logger.log('LOGGER ERROR: %s', e && e.message); } catch (e2) {}
  }
}

// Normalize Playing column values: only explicit yes/y/true/1 count as playing
function isPlayingValue(v) {
  try {
    if (v === true) return true;
    if (v === false || v === null || v === undefined) return false;
    const s = String(v).trim().toLowerCase();
    return s === 'yes' || s === 'y' || s === 'true' || s === '1';
  } catch (e) {
    L('PLAY ERR', 'isPlayingValue exception', { message: e && e.message });
    return false;
  }
}

// Tolerant loadPlayers: detects header variants and chooses best match for Playing column
function loadPlayers() {
  L('LOAD START', 'entering loadPlayers (tolerant)');
  try {
    const ss = SpreadsheetApp.getActive();
    const sheet = ss.getSheetByName('Players') || ss.getSheetByName('PLAYERS');
    if (!sheet) {
      L('LOAD INFO', 'Players sheet not found; returning empty array');
      return [];
    }

    const data = sheet.getDataRange().getValues();
    if (!data || data.length < 1) {
      L('LOAD INFO', 'Players sheet empty; returning empty array');
      return [];
    }

    const rawHeader = data[0].map(h => (h === undefined || h === null) ? '' : String(h).trim());
    const header = rawHeader.map(h => h.toLowerCase());
    L('LOAD INFO', 'raw header', { rawHeader });

    // tolerant variants for each logical column
    const nameVariants = ['player','name','player name','participant','participant name'];
    const groupVariants = ['group','grp','group name'];
    const playingVariants = ['playing','play','playing?','playing (yes/no)','playing (y/n)','playing (yes/no)'];
    const groupLevelVariants = ['grouplevel','group level','level','group-level'];
    const courtsCountVariants = ['courtscount','courts count','courts','courts_count'];

    function findIndex(variants) {
      // exact match first
      for (let i = 0; i < header.length; i++) {
        for (const v of variants) {
          if (header[i] === v) return i;
        }
      }
      // substring match
      for (let i = 0; i < header.length; i++) {
        for (const v of variants) {
          if (header[i].indexOf(v) !== -1) return i;
        }
      }
      // fuzzy: remove non-alphanum and compare
      function norm(s){ return s.replace(/[^a-z0-9]/g,''); }
      const normHeader = header.map(h => norm(h));
      for (let i = 0; i < normHeader.length; i++) {
        for (const v of variants) {
          if (normHeader[i] === norm(v)) return i;
        }
      }
      return -1;
    }

    const nameIdx = findIndex(nameVariants) !== -1 ? findIndex(nameVariants) : 0;
    const groupIdx = findIndex(groupVariants);
    const playingIdx = findIndex(playingVariants);
    const groupLevelIdx = findIndex(groupLevelVariants);
    const courtsCountIdx = findIndex(courtsCountVariants);

    L('LOAD INFO', 'detected indexes (tolerant)', { nameIdx, groupIdx, playingIdx, groupLevelIdx, courtsCountIdx });

    // If playingIdx still not found, attempt to detect a yes/no column by sampling columns
    let finalPlayingIdx = playingIdx;
    if (finalPlayingIdx === -1) {
      const rowsToScan = Math.min(30, data.length - 1);
      let bestIdx = -1;
      let bestScore = 0;
      for (let c = 0; c < data[0].length; c++) {
        let score = 0;
        for (let r = 1; r <= rowsToScan; r++) {
          const v = data[r][c];
          if (v === undefined || v === null) continue;
          const s = String(v).trim().toLowerCase();
          if (s === 'yes' || s === 'no' || s === 'y' || s === 'n' || s === 'true' || s === 'false' || s === '1' || s === '0') score++;
        }
        if (score > bestScore) { bestScore = score; bestIdx = c; }
      }
      if (bestScore >= Math.max(3, Math.floor(rowsToScan * 0.3))) {
        finalPlayingIdx = bestIdx;
        L('LOAD INFO', 'playing column inferred by yes/no prevalence', { finalPlayingIdx, bestScore, rowsScanned: rowsToScan });
      } else {
        L('LOAD WARN', 'could not reliably detect Playing column; will fallback to column index 2 if present', {});
        finalPlayingIdx = (data[0].length > 2) ? 2 : -1;
      }
    } else {
      L('LOAD INFO', 'playing header detected by tolerant match', { playingIdx: finalPlayingIdx });
    }

    const players = [];
    for (let r = 1; r < data.length; r++) {
      const row = data[r];
      const raw = row.map(c => (c === undefined || c === null) ? '' : String(c));
      const name = String(row[nameIdx] || '').trim();
      if (!name) {
        L('LOAD SKIP', 'skipping row with empty name', { row: r+1 });
        continue;
      }
      const groupRaw = (groupIdx >= 0) ? row[groupIdx] : '';
      const group = String(groupRaw || 'D').trim().toUpperCase();
      const rawPlaying = (finalPlayingIdx >= 0) ? row[finalPlayingIdx] : '';
      const playing = isPlayingValue(rawPlaying);
      const groupLevel = (groupLevelIdx >= 0) ? (row[groupLevelIdx] || '') : '';
      const courtsCount = (courtsCountIdx >= 0) ? Number(row[courtsCountIdx]) || null : null;

      const p = { name, group, playing, groupLevel, courtsCount, raw };
      players.push(p);

      if (players.length <= 10) {
        L('LOAD ROW', 'parsed player', { row: r+1, name, group, rawPlaying, playing });
      } else if (players.length === 11) {
        L('LOAD INFO', 'parsed >10 players; further rows summarized only', {});
      }
    }

    L('LOAD END', 'loaded players', { count: players.length, playingDetectedColumn: finalPlayingIdx });
    return players;
  } catch (e) {
    L('LOAD ERR', 'exception in tolerant loadPlayers', { message: e && e.message });
    throw e;
  }
}

// Full replacement: generateATeams with rank -> groupLevel -> sheetOrder tie-breakers
// Full replacement: generateATeams using GroupLevel as primary rank
// Full replacement: generateATeams with GroupLevel primary, waited-priority, randomized ties
function generateATeams(players, courts) {
  L('GEN A START', 'entering generateATeams (GroupLevel primary, waited-priority, randomized ties)', { playersCount: Array.isArray(players) ? players.length : 0, courts: courts });
  try {
    players = Array.isArray(players) ? players.slice() : [];
    const maxMatches = Math.max(0, Math.floor(Number(courts) || 0));
    L('GEN A INFO', 'computed maxMatches', { maxMatches });

    // Helper: extract numeric wait score from player object or raw row
    function getWaitScore(p) {
      try {
        // Common property names
        const candidates = ['waited','waitCount','waitcount','wait','waiting','wait_score','waitscore'];
        for (const k of candidates) {
          if (p.hasOwnProperty(k)) {
            const v = p[k];
            if (v === true) return 1;
            if (v === false || v === null || v === undefined) continue;
            const n = Number(v);
            if (!isNaN(n)) return Math.max(0, Math.floor(n));
            const s = String(v).trim().toLowerCase();
            if (s === 'yes' || s === 'y' || s === 'true') return 1;
            if (s === 'no' || s === 'n' || s === 'false') return 0;
          }
        }
        // If not found in properties, inspect raw row array (if present)
        if (Array.isArray(p.raw)) {
          for (let i = p.raw.length - 1; i >= 0; i--) {
            const cell = p.raw[i];
            if (cell === undefined || cell === null) continue;
            const s = String(cell).trim();
            if (s === '') continue;
            const n = Number(s);
            if (!isNaN(n)) return Math.max(0, Math.floor(n));
            const sl = s.toLowerCase();
            if (sl === 'yes' || sl === 'y' || sl === 'true') return 1;
            if (sl === 'no' || sl === 'n' || sl === 'false') return 0;
            // look for "wait" token followed by number e.g., "wait:2" or "waited 3"
            const m = s.match(/wait(?:ed|ing)?\D*([0-9]+)/i);
            if (m && m[1]) return Math.max(0, Math.floor(Number(m[1])));
          }
        }
      } catch (e) {
        L('GEN A WARN', 'getWaitScore error', { message: e && e.message, player: p && p.name });
      }
      return 0;
    }

    // Fisher-Yates shuffle for tie-randomization
    function shuffleInPlace(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const tmp = arr[i];
        arr[i] = arr[j];
        arr[j] = tmp;
      }
    }

    // Build A players list with normalized groupLevel, waitScore and original index for stable tie-break fallback
    const aPlayers = [];
    for (let i = 0; i < players.length; i++) {
      const p = players[i];
      if (!p) continue;
      if (String(p.group || '').toUpperCase() !== 'A') continue;
      if (!p.playing) continue;
      let gl = Number(p.groupLevel);
      if (isNaN(gl)) gl = Number.MAX_SAFE_INTEGER;
      const waitScore = getWaitScore(p);
      aPlayers.push({ name: String(p.name), groupLevel: gl, waitScore: waitScore, sheetIndex: i, raw: p.raw || null });
    }

    L('GEN A INFO', 'filtered A players before sort', { aCount: aPlayers.length, aPlayers: aPlayers.map(p => ({ name: p.name, groupLevel: p.groupLevel, waitScore: p.waitScore, idx: p.sheetIndex })) });

    // Group by groupLevel and waitScore to randomize ties
    // First sort by groupLevel asc, waitScore desc (prefer higher waitScore), sheetIndex asc to create stable buckets
    aPlayers.sort((x, y) => {
      if (x.groupLevel !== y.groupLevel) return x.groupLevel - y.groupLevel;
      if (x.waitScore !== y.waitScore) return y.waitScore - x.waitScore; // higher waitScore first
      return x.sheetIndex - y.sheetIndex;
    });

    // Now identify contiguous tie blocks where groupLevel and waitScore are equal, and shuffle within each block
    let i = 0;
    while (i < aPlayers.length) {
      let j = i + 1;
      while (j < aPlayers.length && aPlayers[j].groupLevel === aPlayers[i].groupLevel && aPlayers[j].waitScore === aPlayers[i].waitScore) j++;
      if (j - i > 1) {
        const block = aPlayers.slice(i, j);
        shuffleInPlace(block);
        // replace back
        for (let k = i; k < j; k++) aPlayers[k] = block[k - i];
        L('GEN A INFO', 'randomized tie block', { groupLevel: aPlayers[i].groupLevel, waitScore: aPlayers[i].waitScore, names: aPlayers.slice(i, j).map(x => x.name) });
      }
      i = j;
    }

    L('GEN A INFO', 'final ordered A players', { aPlayers: aPlayers.map(p => ({ name: p.name, groupLevel: p.groupLevel, waitScore: p.waitScore, idx: p.sheetIndex })) });

    const matches = [];
    for (let m = 0; m < maxMatches && aPlayers.length > 0; m++) {
      const take = Math.min(4, aPlayers.length);
      const team = aPlayers.splice(0, take);
      matches.push({ group: 'A', players: team.map(t => t.name), groupLevels: team.map(t => t.groupLevel), waitScores: team.map(t => t.waitScore) });
      if (take === 4) {
        L('GEN A TEAM', 'formed full team (GroupLevel primary, waited-priority)', { court: matches.length, players: team.map(t => t.name), groupLevels: team.map(t => t.groupLevel), waitScores: team.map(t => t.waitScore) });
      } else {
        L('GEN A TEAM', 'formed partial team (GroupLevel primary, waited-priority)', { court: matches.length, players: team.map(t => t.name), groupLevels: team.map(t => t.groupLevel), waitScores: team.map(t => t.waitScore) });
      }
    }

    const leftovers = aPlayers.map(p => p.name);
    L('GEN A END', 'exiting generateATeams', { matches: matches.length, leftovers });

    // Return matches without internal arrays (players list only)
    const outMatches = matches.map(m => ({ group: m.group, players: m.players }));
    return { matches: outMatches, leftovers };
  } catch (err) {
    L('GEN A ERR', 'exception in generateATeams', { message: err && err.message });
    throw err;
  }
}

// getCourtsCount: uses Settings!B1 override, else computes from Players with Playing=yes and Group=A
// getCourtsCount: use the value in the first row under the header "CourtsCount"
// Full replacement function — paste as-is. Uses L(...) for logging and loadPlayers() if available.
function getCourtsCount() {
  L('COURTS START', 'entering getCourtsCount (first-row CourtsCount)');
  try {
    const ss = SpreadsheetApp.getActive();
    const sheet = ss.getSheetByName('Players') || ss.getSheetByName('PLAYERS');
    if (sheet) {
      try {
        const data = sheet.getDataRange().getValues();
        if (data && data.length > 0) {
          const header = data[0].map(h => (h === undefined || h === null) ? '' : String(h).trim().toLowerCase());
          L('COURTS INFO', 'Players header detected', { header });
          // find exact header index for CourtsCount (case-insensitive exact match)
          let courtsIdx = -1;
          for (let i = 0; i < header.length; i++) {
            if (header[i] === 'courtscount') { courtsIdx = i; break; }
          }
          if (courtsIdx !== -1) {
            // scan the first data row under header (row index 1 in data array)
            // Use the very first non-empty cell under that column (row 2 in sheet)
            let found = null;
            for (let r = 1; r < data.length; r++) {
              const raw = data[r][courtsIdx];
              if (raw !== undefined && raw !== null && String(raw).toString().trim() !== '') {
                found = raw;
                L('COURTS INFO', 'found CourtsCount value in Players sheet', { row: r+1, raw: found });
                break;
              }
            }
            if (found !== null) {
              const n = Number(found);
              if (!isNaN(n) && n > 0) {
                const out = Math.floor(n);
                L('COURTS INFO', 'using CourtsCount from first non-empty row under header', { value: out });
                return out;
              } else {
                L('COURTS WARN', 'CourtsCount value found but not a positive number', { raw: found });
              }
            } else {
              L('COURTS INFO', 'CourtsCount header present but no non-empty value found under it');
            }
          } else {
            L('COURTS INFO', 'CourtsCount header not found in Players header');
          }
        } else {
          L('COURTS INFO', 'Players sheet has no rows');
        }
      } catch (e) {
        L('COURTS ERR', 'error reading Players sheet CourtsCount column', { message: e && e.message });
      }
    } else {
      L('COURTS INFO', 'Players sheet not found when checking CourtsCount column');
    }
  } catch (e) {
    L('COURTS ERR', 'unexpected error while attempting to read Players sheet', { message: e && e.message });
  }

  // If we reach here, try Settings!B1 override (existing behavior)
  try {
    const ss = SpreadsheetApp.getActive();
    const settings = ss.getSheetByName('Settings') || ss.getSheetByName('SETTINGS');
    if (settings) {
      const v = settings.getRange(1, 2).getValue();
      const n = Number(v);
      if (!isNaN(n) && n > 0) {
        L('COURTS INFO', 'using Settings!B1 override', { value: Math.floor(n) });
        return Math.floor(n);
      }
      L('COURTS INFO', 'Settings!B1 present but not valid number', { raw: v });
    }
  } catch (e) {
    L('COURTS ERR', 'reading Settings failed', { message: e && e.message });
  }

  // Fallback: compute from loaded players (Playing = yes, Group = A)
  try {
    const players = (typeof loadPlayers === 'function') ? loadPlayers() : [];
    if (!Array.isArray(players) || players.length === 0) {
      L('COURTS INFO', 'no players loaded; fallback to 1 court');
      return 1;
    }
    const playingA = players.filter(p => p && String(p.group || '').toUpperCase() === 'A' && !!p.playing).length;
    const computed = Math.max(1, Math.ceil(playingA / 4));
    L('COURTS INFO', 'computed from Players fallback', { playingA, computed });
    return computed;
  } catch (e) {
    L('COURTS ERR', 'computing courts from players failed', { message: e && e.message });
  }

  L('COURTS END', 'final fallback to 1 court');
  return 1;
}

// Orchestrator: loads players (using exact headers), computes courts, generates matches, writes sheet
function runGenerateRound() {
  L('RUN START', 'starting runGenerateRound (exact headers)');
  const roundNumber = 1;

  let players = [];
  try {
    players = loadPlayers(); // our exact-header loader
    L('RUN SRC', 'loadPlayers returned', { count: players.length });
  } catch (e) {
    L('RUN ERR', 'loadPlayers threw', { message: e && e.message });
    players = [];
  }

  const courts = getCourtsCount();
  L('RUN INFO', 'using courts', { courts });

  let result = { matches: [], leftovers: [] };
  try {
    result = generateATeams(players, courts) || result;
    L('RUN INFO', 'generator returned', { matches: (result.matches || []).length, leftovers: (result.leftovers || []).length });
  } catch (e) {
    L('RUN ERR', 'generateATeams threw', { message: e && e.message });
    throw e;
  }

  try {
    if (typeof writeMatchesSheetWithWaiters === 'function') {
      writeMatchesSheetWithWaiters(result.matches || [], result.leftovers || [], roundNumber);
      L('RUN INFO', 'wrote matches via writer', { matches: (result.matches || []).length });
    } else {
      L('RUN WARN', 'writeMatchesSheetWithWaiters not found; matches not written', { matches: (result.matches || []).length });
    }
  } catch (e) {
    L('RUN ERR', 'writer threw', { message: e && e.message });
    throw e;
  }

  L('RUN END', 'runGenerateRound complete', { matches: (result.matches || []).length, leftovers: (result.leftovers || []).length });
  return { roundNumber, matches: result.matches || [], leftovers: result.leftovers || [] };
}

// Safe writer: writes Matches sheet header, timestamp, matches, and Players Waiting cell
function writeMatchesSheetWithWaiters(matches, leftovers, roundNumber) {
  L('WRITE START', 'entering writeMatchesSheetWithWaiters', { matches: matches.length, leftovers: leftovers.length, round: roundNumber });
  try {
    const ss = SpreadsheetApp.getActive();
    let sheet = ss.getSheetByName('Matches');
    if (!sheet) sheet = ss.insertSheet('Matches');

    const header = ['Round','Court','Team1 P1','Team1 P2','Team2 P1','Team2 P2','Type','Score','Players Waiting'];
    sheet.getRange(1,1,1,header.length).setValues([header]);

    const nowText = 'Generated on ' + Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone() || 'GMT', 'dd MMM yyyy, HH:mm');
    sheet.getRange(2,1).setValue(nowText);

    const maxRowsToClear = Math.max(100, matches.length + 10);
    sheet.getRange(3,1,maxRowsToClear, header.length).clearContent();

    const rows = [];
    for (let i = 0; i < matches.length; i++) {
      const m = matches[i];
      const courtLabel = 'Court ' + (i + 1);
      const p = (m.players || []).slice(0,4);
      const team1p1 = p[0] || '';
      const team1p2 = p[1] || '';
      const team2p1 = p[2] || '';
      const team2p2 = p[3] || '';
      const type = m.group || 'A';
      rows.push([roundNumber, courtLabel, team1p1, team1p2, team2p1, team2p2, type, '', '']);
    }

    if (rows.length > 0) sheet.getRange(3,1,rows.length, header.length).setValues(rows);

    const waitingStartRow = 3 + Math.max(0, rows.length);
    if (leftovers && leftovers.length > 0) {
      sheet.getRange(waitingStartRow, 9).setValue(leftovers.join(', '));
      L('WRITE INFO', 'wrote leftovers', { row: waitingStartRow, count: leftovers.length });
    } else {
      sheet.getRange(waitingStartRow, 9).clearContent();
      L('WRITE INFO', 'no leftovers to write', {});
    }

    L('WRITE END', 'writeMatchesSheetWithWaiters complete', { rowsWritten: rows.length });
  } catch (e) {
    L('WRITE ERR', 'exception in writer', { message: e && e.message });
    throw e;
  }
}

function listPlayingPlayers() {
  L('DIAG START', 'entering listPlayingPlayers');
  try {
    const players = (typeof loadPlayers === 'function') ? loadPlayers() : [];
    L('DIAG INFO', 'players loaded for diagnostic', { totalLoaded: players.length });

    const byGroup = {};
    for (let i = 0; i < players.length; i++) {
      const p = players[i];
      if (!p) continue;
      if (!p.playing) continue;
      const g = String(p.group || 'D').toUpperCase();
      if (!byGroup[g]) byGroup[g] = [];
      byGroup[g].push({ name: p.name, rowRaw: p.raw });
    }

    const groups = Object.keys(byGroup).sort();
    if (groups.length === 0) {
      L('DIAG INFO', 'no players with Playing = yes found');
    } else {
      L('DIAG INFO', 'players with Playing = yes by group', { groups: groups });
      for (const g of groups) {
        const list = byGroup[g].map(x => x.name);
        L('DIAG GROUP', 'group summary', { group: g, count: list.length, names: list });
        for (let i = 0; i < Math.min(10, byGroup[g].length); i++) {
          L('DIAG ROW', 'raw row for player', { group: g, name: byGroup[g][i].name, raw: byGroup[g][i].rowRaw });
        }
      }
    }

    L('DIAG END', 'listPlayingPlayers complete', { groupsCount: groups.length });
    return byGroup;
  } catch (e) {
    L('DIAG ERR', 'exception in listPlayingPlayers', { message: e && e.message });
    throw e;
  }
}